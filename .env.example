NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PEXELS_API_KEY=
N8N_INTERNAL_SECRET=

# Ask Zippy. Anthropic key must be workspace-scoped and the account needs credits.
ANTHROPIC_API_KEY=
# Used for knowledge embeddings.
OPENAI_API_KEY=
# Optional overrides
ZIPPY_CLAUDE_MODEL=claude-sonnet-5-5
ZIPPY_EMBEDDING_MODEL=text-embedding-3-small
# Ask Zippy limits and proxy trust (all optional, integers 1 to 1000000; see docs/DEPLOYMENT.md,
# "Public deployment checklist"). Values shown are the defaults.
# ZIPPY_TRUSTED_PROXY_HOPS=1
# ZIPPY_LIMIT_USER_PER_MIN=10
# ZIPPY_LIMIT_USER_PER_DAY=60
# ZIPPY_LIMIT_VISITOR_PER_MIN=5
# ZIPPY_LIMIT_VISITOR_PER_DAY=20
# ZIPPY_LIMIT_GLOBAL_VISITORS_PER_MIN=60
# ZIPPY_LIMIT_GLOBAL_VISITORS_PER_DAY=1000
# ZIPPY_LIMIT_GLOBAL_USERS_PER_MIN=120
# ZIPPY_LIMIT_GLOBAL_USERS_PER_DAY=5000
# ZIPPY_LIMIT_ALL_PER_DAY=8000
# ZIPPY_LIMIT_IP_BURST_PER_MIN=40
# Optional secret salt mixed into the per-IP rate-limit hash (empty or unset = unsalted). Changing it resets IP buckets.
# ZIPPY_IP_HASH_SALT=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Server-side Google key used ONLY by POST /api/auth/signup to geocode the registration address.
# Restrict it to the Geocoding API and server use. Never prefix with NEXT_PUBLIC; never put it in the browser or phone app.
GOOGLE_MAPS_SERVER_API_KEY=

# Public address customers open from emails (the review request link).
PUBLIC_APP_URL=http://localhost:3000

# Optional: per-IP limit per minute for the login page's registration-status lookup (integer 1 to 1000000, default 20).
# REGISTRATION_STATUS_LIMIT_PER_MINUTE=20
