# Copy this file to .env and fill in real values.
# For local dev, use the same self-hosted Supabase instance the web app
# (repo root .env.local) points at.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key-here

# Base URL for the Next.js app's API routes (/api/cart/checkout, /api/delivery/*).
# On a physical device, localhost means the device itself — use your machine's
# LAN IP instead, e.g. http://192.168.1.23:3000
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.23:3000

# Google Maps SDK for Android key, used only when the app is built natively (a development or
# release build); Expo Go ignores it. Create it in console.cloud.google.com with the Maps SDK for
# Android enabled and restrict it to package com.freshquick.app plus the build's SHA-1.
# The same key is also used by the phone's live address search, so its API restrictions must now
# also include Places API (New) and Geocoding API. Those calls only work in a native Android
# build (Expo Go is rejected by Google and the app falls back to manual address entry).
GOOGLE_MAPS_ANDROID_API_KEY=your-android-maps-key-here

# SHA-1 of the signing certificate the key is restricted to (hex, colons optional). Not a secret.
# Leave unset to use the public Expo debug certificate.
GOOGLE_MAPS_ANDROID_CERT_SHA1=5E8F16062EA3CD2C4A0D547876BAA6F38CABF625
